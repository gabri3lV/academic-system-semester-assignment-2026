<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="450.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.academic.system.view.AssessmentRegistrationController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>

    <Label text="Registrar Nova Avaliação" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
    </Label>

    <VBox maxWidth="400.0" spacing="5.0">
        <Label text="Selecione a Turma:" />
        <ComboBox fx:id="cbCourseCode" maxWidth="Infinity" promptText="Escolha a turma..." />
    </VBox>

    <VBox maxWidth="400.0" spacing="5.0">
        <Label text="Tipo de Avaliação:" />
        <ComboBox fx:id="cbAssessmentType" maxWidth="Infinity" promptText="Escolha o tipo..." />
    </VBox>

    <VBox maxWidth="400.0" spacing="5.0">
        <Label text="Valor (Nota Máxima):" />
        <TextField fx:id="txtValue" promptText="Ex: 10.0" />
    </VBox>

    <VBox maxWidth="400.0" spacing="5.0">
        <Label text="Peso (Ex: 0.5 para 50%):" />
        <TextField fx:id="txtWeight" promptText="Ex: 0.5" />
    </VBox>

    <Button mnemonicParsing="false" onAction="#handleSaveAssessment" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar Avaliação">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Button>
</VBox>