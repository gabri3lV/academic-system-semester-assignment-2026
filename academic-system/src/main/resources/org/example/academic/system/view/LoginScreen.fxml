<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.academic.system.view.LoginController">
    <padding>
        <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
    </padding>

    <Label text="Academic System" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
    </Label>

    <VBox maxWidth="300.0" spacing="5.0">
        <Label text="Usuário:" />
        <TextField fx:id="txtUsername" promptText="Ex: admin ou prof" />
    </VBox>

    <VBox maxWidth="300.0" spacing="5.0">
        <Label text="Senha:" />
        <PasswordField fx:id="txtPassword" promptText="Digite 123" />
    </VBox>

    <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="300.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="Entrar">
        <VBox.margin>
            <Insets top="15.0" />
        </VBox.margin>
    </Button>
</VBox>