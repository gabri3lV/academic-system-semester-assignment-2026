<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.academic.system.view.MainScreenController">
    <left>
        <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <Label text="Menu Principal" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>

            <Button fx:id="btnClassRegistration" maxWidth="Infinity" mnemonicParsing="false" onAction="#showClassRegistration" text="Registrar Turmas" />
            <Button fx:id="btnAssessmentRegistration" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAssessmentRegistration" text="Registrar Avaliações" />
            <Button fx:id="btnVisualization" maxWidth="Infinity" mnemonicParsing="false" onAction="#showVisualization" text="Visualizar Dados" />
            <Button fx:id="btnReports" maxWidth="Infinity" mnemonicParsing="false" onAction="#showReports" text="Relatórios" />
            <Button fx:id="btnPersistenceConfig" maxWidth="Infinity" mnemonicParsing="false" onAction="#showPersistenceConfig" text="Configurar Persistência" />

            <VBox prefHeight="100.0" VBox.vgrow="ALWAYS" />

            <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" text="Sair (Logout)" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <Label text="Bem-vindo ao Academic System" textFill="#7f8c8d">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
            <Label text="Selecione uma opção no menu lateral para começar." textFill="#95a5a6" />
        </VBox>
    </center>
</BorderPane>