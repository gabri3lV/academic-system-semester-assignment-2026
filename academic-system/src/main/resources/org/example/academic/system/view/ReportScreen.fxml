<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="700.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.academic.system.view.ReportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Relatórios Acadêmicos e de Sistema" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#handleClassSummaryReport" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Resumo de Avaliações" />
        <Button mnemonicParsing="false" onAction="#handleWeightValidationReport" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Validação de Pesos" />
        <Button fx:id="btnPersistenceReport" mnemonicParsing="false" onAction="#handlePersistenceReport" style="-fx-background-color: #e67e22; -fx-text-fill: white;" text="Configuração de Persistência" />
    </HBox>

    <Label text="Resultado:" textFill="#7f8c8d">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TextArea fx:id="txtReportOutput" editable="false" prefHeight="300.0" prefWidth="200.0" style="-fx-font-family: 'monospaced';" VBox.vgrow="ALWAYS">
        <font>
            <Font size="14.0" />
        </font>
    </TextArea>
</VBox>